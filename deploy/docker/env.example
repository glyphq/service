# Copy this file to .env at the repository root, then edit secrets and peers.
# scripts/docker-up.sh and docker-down.sh pass .env to `docker compose`
# automatically. Values shown here are the Compose defaults.

# --- ClickHouse -----------------------------------------------------------
CLICKHOUSE_DB=glyph
CLICKHOUSE_USER=glyph
# Use a URL-safe password (letters, digits, - or _) and keep it in sync with
# CLICKHOUSE_URL below. Percent-encode special characters if you must use them.
CLICKHOUSE_PASSWORD=change-me
# Host loopback port for the ClickHouse HTTP endpoint.
CLICKHOUSE_HTTP_PORT=8123
# Changing CLICKHOUSE_URL requires the API and indexer to reach that address
# from inside the Compose network. The default is the clickhouse service.
CLICKHOUSE_URL=http://glyph:change-me@clickhouse:8123

# --- API ------------------------------------------------------------------
# Container listen address. Keep the port at 8080 unless you also change the
# api port mapping in docker-compose.yml.
BIND=0.0.0.0:8080
# Host interface and port published for the API.
API_HOST=127.0.0.1
API_PORT=8080
# Disabled by default. Set true only for a trusted API deployment.
ALLOW_BROADCAST=false
# Stream hub index-head poll interval in milliseconds.
STREAM_POLL_MS=1000
# Live QUBIC/USDT price feed refresh interval in the API.
PRICE_POLL_MS=60000
# External exchange consensus. Set MARKET_ENABLED=false to disable it.
MARKET_ENABLED=true
MARKET_POLL_MS=5000
# COINGECKO_API_KEY=
# RUST_LOG=info,tower_http=info

# --- Indexer --------------------------------------------------------------
# Comma-separated Qubic peer socket addresses. The indexer entrypoint also
# accepts whitespace, but the API parses commas, so prefer commas.
QUBIC_PEERS=157.180.10.49:21841
# GLYPH_FROM_TICK=91915000
INDEXER_POLL_MS=750
INDEXER_PROGRESS_EVERY=100
# Backfill throughput: more connections and a larger in-flight window fetch
# faster but use more memory. The ordered writer still verifies in order.
INDEXER_FETCH_CONCURRENCY=32
INDEXER_FETCH_WINDOW=512
INDEXER_CONNECTIONS_PER_PEER=2
INDEXER_WRITE_BATCH=128
INDEXER_WRITE_FLUSH_MS=250
# INDEXER_VERIFY_CONCURRENCY=3
# Append peers advertised by the seed. Uses port 21841 for IPv4 addresses.
INDEXER_DISCOVER_PEERS=false
GLYPH_VERIFY_SIGNATURES=false

# --- Object storage / raw archive ----------------------------------------
# These values configure both SeaweedFS and the S3 client settings passed to
# the Glyph processes. Change the secret before exposing the stack.
S3_ACCESS_KEY=glyph
S3_SECRET_KEY=glyph-dev-secret
S3_BUCKET=glyph-archive
S3_REGION=us-east-1
# Internal endpoint used by the API and indexer.
S3_ENDPOINT=http://seaweedfs:8333
# Stop ingestion when a bundle cannot be archived. False logs and continues.
ARCHIVE_FAIL_CLOSED=false
# Store full vote headers in every tick bundle. Off by default; the computor set
# is written once per epoch at raw/epoch=NNN/computors.bin.
ARCHIVE_VOTES=false
# Optional retention after an epoch rollover. Drops ClickHouse partitions older
# than this many epochs. Leave unset to keep every indexed epoch.
# PRUNE_KEEP_EPOCHS=54
# Host loopback port for the SeaweedFS S3 API.
S3_PORT=8333

# --- Mempool and webhooks ------------------------------------------------
# The API submits POST /v1/transactions to the mempool by default. Mempool
# entries still require ALLOW_BROADCAST=true to reach peers. Set false to
# disable mempool persistence and background tracking.
MEMPOOL_ENABLED=true
MEMPOOL_POLL_MS=500
MEMPOOL_RETRY_MS=1000
MEMPOOL_MAX_ATTEMPTS=10
MEMPOOL_EXPIRY_TICKS=10
MEMPOOL_MAX_ENTRIES=10000
MEMPOOL_MAX_PER_SOURCE=100
BROADCAST_PEERS=8
# Signed webhook delivery. Keep WEBHOOK_ALLOW_PRIVATE=false unless receivers
# are internal and trusted.
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_ALLOW_PRIVATE=false
# 32-byte hex or base64. run-stack.sh generates and persists one when unset.
# WEBHOOK_ENCRYPTION_KEY=

# --- Images and logging ---------------------------------------------------
# GLYPH_IMAGE=glyph:local
# GLYPH_API_LOG=info,tower_http=info
# GLYPH_INDEXER_LOG=info
# GLYPH_MIGRATE_LOG=info
