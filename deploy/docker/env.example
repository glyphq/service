# Copy this file to .env at the repository root, then edit secrets and peers.
# scripts/docker-up.sh and docker-down.sh pass .env to `docker compose`
# automatically. Values shown here are the Compose defaults.

# --- ClickHouse -----------------------------------------------------------
CLICKHOUSE_DB=glyph
# Host loopback port for the ClickHouse HTTP endpoint.
CLICKHOUSE_HTTP_PORT=8123
# Changing CLICKHOUSE_URL requires the API and indexer to reach that address
# from inside the Compose network. The default is the clickhouse service.
# CLICKHOUSE_URL=http://clickhouse:8123

# --- API ------------------------------------------------------------------
# Container listen address. Keep the port at 8080 unless you also change the
# api port mapping in docker-compose.yml.
BIND=0.0.0.0:8080
# Host interface and port published for the API.
API_HOST=127.0.0.1
API_PORT=8080
# Disabled by default. Set true only for a trusted API deployment.
ALLOW_BROADCAST=false
# Stream hub index-head poll interval in milliseconds.
STREAM_POLL_MS=1000
# RUST_LOG=info,tower_http=info

# --- Indexer --------------------------------------------------------------
# Comma-separated Qubic peer socket addresses. The indexer entrypoint also
# accepts whitespace, but the API parses commas, so prefer commas.
QUBIC_PEERS=157.180.10.49:21841
# GLYPH_FROM_TICK=91915000
INDEXER_POLL_MS=750
INDEXER_PROGRESS_EVERY=100
GLYPH_VERIFY_SIGNATURES=true

# --- Object storage / raw archive ----------------------------------------
# These values configure both MinIO and the S3 client settings passed to the
# Glyph processes. Change the secret before exposing the stack beyond localhost.
S3_ACCESS_KEY=glyph
S3_SECRET_KEY=glyph-dev-secret
S3_BUCKET=glyph-archive
S3_REGION=us-east-1
# Internal endpoint used by the API and indexer.
S3_ENDPOINT=http://minio:9000
# Stop ingestion when a bundle cannot be archived. False logs and continues.
ARCHIVE_FAIL_CLOSED=false
# Host loopback ports for the MinIO S3 API and console.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Images and logging ---------------------------------------------------
# GLYPH_IMAGE=glyph:local
# GLYPH_API_LOG=info,tower_http=info
# GLYPH_INDEXER_LOG=info
# GLYPH_MIGRATE_LOG=info
