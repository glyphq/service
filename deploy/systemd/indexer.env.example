# /etc/glyph/indexer.env
# One indexer per database. The indexer owns the ingest cursor.
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=glyph
QUBIC_PEERS=157.180.10.49:21841,198.27.75.81:21841
INDEXER_FETCH_CONCURRENCY=32
INDEXER_FETCH_WINDOW=512
INDEXER_WRITE_BATCH=128
INDEXER_WRITE_FLUSH_MS=250
# INDEXER_VERIFY_CONCURRENCY=3
INDEXER_DISCOVER_PEERS=false
RUST_LOG=info
# Optional filesystem archive. Prefer S3 and set the S3_* variables instead.
# ARCHIVE_DIR=/var/lib/glyph/archive
# ARCHIVE_FAIL_CLOSED=false
