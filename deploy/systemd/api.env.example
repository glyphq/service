# /etc/glyph/api.env
# Read-only API process. Keep the listener on loopback and terminate TLS in
# Caddy, nginx, or another reverse proxy.
BIND=127.0.0.1:8080
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=glyph
QUBIC_PEERS=157.180.10.49:21841,198.27.75.81:21841
ALLOW_BROADCAST=false
STREAM_POLL_MS=1000
PRICE_POLL_MS=60000
RUST_LOG=info,tower_http=info
